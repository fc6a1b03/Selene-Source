<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- USB Video Class (UVC) 设备过滤器 -->
    <!-- 允许所有 UVC 摄像头设备 -->
    <!-- MS2109 (Hagibis THC01 等采集卡) -->
    <usb-device vendor-id="0x534d" product-id="0x2109" />
    <!-- MS2130 (新款采集卡) -->
    <usb-device vendor-id="0x534d" product-id="0x2130" />
    <!-- 通配符配置 - 允许所有视频类设备 -->
    <usb-device class="239" subclass="2" protocol="1" />
    <!-- 常用 UVC 摄像头 Vendor ID -->
    <!-- Logitech -->
    <usb-device vendor-id="0x046d" />
    <!-- Microsoft -->
    <usb-device vendor-id="0x045e" />
    <!-- Creative -->
    <usb-device vendor-id="0x041e" />
    <!-- HP -->
    <usb-device vendor-id="0x03f0" />
    <!-- Lenovo -->
    <usb-device vendor-id="0x17ef" />
</resources>
